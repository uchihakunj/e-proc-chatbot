[Unit]
Description=CHiPS e-Procurement Chatbot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chips
Group=chips
WorkingDirectory=/opt/eproc-chatbot
Environment=PORT=3000
Environment=FLASK_URL=http://127.0.0.1:5000
Environment=NODE_ENV=production
Environment=USE_WAITRESS=true
Environment=CUDA_VISIBLE_DEVICES=-1
Environment=EMBEDDER_BACKEND=openvino
Environment=EMBEDDER_DEVICE=CPU
Environment=RERANKER_BACKEND=openvino
Environment=RERANKER_DEVICE=CPU
Environment=PYTHON=/opt/eproc-chatbot/.venv/bin/python
EnvironmentFile=/opt/eproc-chatbot/.env
ExecStart=/opt/eproc-chatbot/start_cpu.sh
Restart=always
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
